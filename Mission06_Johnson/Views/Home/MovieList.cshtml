@model List<Movie>

@{
    ViewData["Title"] = "Movie List";
}

<h1>@ViewData["Title"]</h1>

<table class="table table-bordered">
    <thead class="fw-bold">
    <tr>
        <th>CategoryId</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Lent To</th>
        <th>CopiedToPlex</th>
        <th>Notes</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.CategoryId</td>
            <td>@x.Title</td>
            <td>@x.Year</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@(x.Edited.HasValue ? (x.Edited.Value ? "Yes" : "No") : "Unknown")</td>
            <td>@x.LentTo</td>
            <td>@(x.CopiedToPlex.HasValue ? (x.CopiedToPlex.Value ? "Yes" : "No") : "Unknown")</td>
            <td>@x.Notes</td>
            <td><a class="btn btn-secondary" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a></td>
            <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a></td>
        </tr>
    }
    </tbody>
</table>