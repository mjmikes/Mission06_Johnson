@model Mission06_Johnson.Models.Movie

@{
    ViewData["Title"] = "Movie Form";
}

<h1>@ViewData["Title"]</h1>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter New Movie</title>
</head>
<body>
<h1>Add a New Movie to the Collection</h1>
<form asp-action="@(Model.MovieId == 0 ? "MovieForm" : "Edit")" asp-controller="Home" method="post">
    <input type="hidden" asp-for="MovieId" value="@Model.MovieId">
    <select asp-for="CategoryId" class="form-control" required>
        <option value="" disabled selected>Select a Category</option>
        @foreach (var c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>

    <br/>
    <label asp-for="Title">Title:</label>
    <input asp-for="Title" required>
    <span asp-validation-for="Title" class="text-danger"></span> <!-- ✅ Show error --><br><br>

    <label asp-for="Year">Year:</label>
    <input asp-for="Year" required type="number">
    <span asp-validation-for="Year" class="text-danger"></span> <!-- ✅ Show error --><br><br>

    <label asp-for="Director">Director:</label>
    <input asp-for="Director" required><br><br>

    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating" required>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select><br><br>

    <label asp-for="Edited">Edited:</label>
    <input asp-for="Edited" type="radio" value="true">
    <label for="Edited">Yes</label>
    <input asp-for="Edited" type="radio" value="false">
    <label for="Edited">No</label>
    <span asp-validation-for="Edited" class="text-danger"></span> <!-- ✅ Show error --><br><br>

    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo"><br><br>

    <label asp-for="CopiedToPlex">CopiedToPlex:</label>
    <input asp-for="CopiedToPlex" type="radio" value="true">
    <label for="CopiedToPlex">Yes</label>
    <input asp-for="CopiedToPlex" type="radio" value="false"> <!-- ✅ Corrected this line -->
    <label for="CopiedToPlex">No</label>
    <span asp-validation-for="CopiedToPlex" class="text-danger"></span> <!-- ✅ Show error -->

    <br><br>

    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" maxlength="25"><br><br>

    <button type="submit">Add Movie</button>
</form>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
